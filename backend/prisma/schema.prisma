generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Wall {
  id          Int       @id @default(autoincrement())
  name        String
  description String

  libraries   Library[]
}

model Library {
  id          Int       @id @default(autoincrement())
  name        String
  description String

  wallId      Int?
  wall        Wall? @relation(fields: [wallId], references: [id])

  volumes     Volume[]
}

model Volume {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @default("")

  libraryId   Int
  library     Library  @relation(fields: [libraryId], references: [id])
}