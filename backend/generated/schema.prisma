generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

model Wall {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  libraries Library[]
}

model Library {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  wallId Int?
  wall   Wall? @relation(fields: [wallId], references: [id])

  shelves Shelf[]
}

model Shelf {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  libraryId Int
  library   Library @relation(fields: [libraryId], references: [id])

  volumes Volume[]

  @@index([libraryId])
}

model Volume {
  id      Int    @id @default(autoincrement())
  title   String
  content String @default("")

  shelfId Int
  shelf   Shelf @relation(fields: [shelfId], references: [id])

  @@index([shelfId])
}
